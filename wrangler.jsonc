/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * After changing any binding below, run `pnpm cf-typegen` to regenerate
 * `worker-configuration.d.ts`. Never edit that file by hand.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "coffee-quest",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-31",
	"compatibility_flags": ["nodejs_compat"],
	/**
	 * Custom domain: Cloudflare crea el registro DNS y el certificado. workers.dev sigue activo a propósito.
	 * https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
	 */
	"routes": [{ "pattern": "cafe.maurrod.dev", "custom_domain": true }],
	"workers_dev": true,
	"upload_source_maps": true,
	/**
	 * Observability
	 * https://developers.cloudflare.com/workers/observability/logs/workers-logs/
	 * `head_sampling_rate: 1` keeps every invocation. Lower it on high-traffic
	 * Workers to control ingestion cost.
	 */
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
		},
	},
	/**
	 * Secretos requeridos. GAFETE_SECRET firma el gafete (HMAC).
	 * Local: .dev.vars · Producción: npx wrangler secret put GAFETE_SECRET
	 */
	"secrets": { "required": ["GAFETE_SECRET"] },
	/**
	 * Rate limiting: freno anti-abuso, aproximado y por ubicación.
	 * RATE_LIMITER: por gafete (o por IP si no hay). RATE_LIMITER_IP: tope por IP aunque se junten gafetes;
	 * holgado para una clase detrás de un NAT.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
	 */
	"ratelimits": [
		{ "name": "RATE_LIMITER", "namespace_id": "2180", "simple": { "limit": 60, "period": 60 } },
		{ "name": "RATE_LIMITER_IP", "namespace_id": "2181", "simple": { "limit": 300, "period": 60 } },
	],
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/
	 */
	// "placement": { "mode": "smart" },
	/**
	 * Bindings
	 * Bindings let your Worker interact with Cloudflare Developer Platform resources:
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	// "kv_namespaces": [{ "binding": "MY_KV", "id": "<namespace-id>" }],
	// "r2_buckets": [{ "binding": "MY_BUCKET", "bucket_name": "<bucket-name>" }],
	// "d1_databases": [{ "binding": "MY_DB", "database_name": "<name>", "database_id": "<id>" }],
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" },
	/**
	 * Service Bindings (Worker-to-Worker calls without a public HTTP hop)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }],
}
