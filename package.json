{
	"name": "cloudflare-workers-template",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"deploy": "wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
		"lint": "oxlint -D correctness -D suspicious -A unicorn/consistent-function-scoping -A unicorn/filename-case -A unicorn/no-null -A unicorn/prevent-abbreviations --ignore-pattern dist --ignore-pattern coverage .",
		"lint:fix": "pnpm run lint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.3.6",
		"@types/node": "^26.6.4",
		"oxlint": "^1.86.0",
		"prettier": "^3.9.9",
		"typescript": "^7.0.2",
		"vitest": "~4.1.11",
		"wrangler": "^4.147.0"
	}
}
